# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never in the browser
SEND_SMS_HOOK_SECRET=                 # signs the Supabase Send SMS hook calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                    # server only
TWILIO_WHATSAPP_FROM=                 # approved sender, for example +2348000000000
TWILIO_OTP_CONTENT_SID=               # approved authentication template
TWILIO_REJECT_CONTENT_SID=            # approved utility template (rejection notice)
NEXT_PUBLIC_SITE_URL=                 # the OBN NATION domain, used to build edit and referral links
CRON_SECRET=                          # protects /api/cron/purge-drafts
