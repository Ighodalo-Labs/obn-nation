# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never in the browser
SEND_SMS_HOOK_SECRET=                 # signs the Supabase Send SMS hook calls
NEXT_PUBLIC_MESSAGE_CHANNEL=whatsapp              # "telegram" sends codes and rejection links through the Telegram bot (doc 11)
TELEGRAM_MODE=live                    # "stub" sends nothing and skips the link step. For test numbers only
TELEGRAM_BOT_TOKEN=                   # from @BotFather. Server only. Never paste it in chat
TELEGRAM_WEBHOOK_SECRET=              # random 32+ characters (letters, digits, _ or -). Sent back by Telegram on every webhook call
TELEGRAM_BOT_USERNAME=                # public bot name without @, for example obnnation_bot
WHATSAPP_MODE=live                    # "stub" sends nothing and logs no code. Use until Meta approves the templates
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                    # server only
TWILIO_WHATSAPP_FROM=                 # approved sender. Client chose the OBN NATION number: +2347072767227 (see PRD DF-15)
TWILIO_OTP_CONTENT_SID=               # approved authentication template
TWILIO_REJECT_CONTENT_SID=            # approved utility template (rejection notice)
NEXT_PUBLIC_SITE_URL=                 # the OBN NATION domain, used to build edit and referral links
CRON_SECRET=                          # protects /api/cron/purge-drafts
